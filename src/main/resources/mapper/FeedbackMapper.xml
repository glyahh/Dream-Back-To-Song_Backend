<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dbts.dreambacktosong_backend.mapper.FeedbackMapper">

    <!-- 意见反馈表映射，对应表：feedback -->
    <resultMap id="FeedbackResultMap" type="com.dbts.dreambacktosong_backend.domain.entity.Feedback">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="rate" column="rate"/>
        <result property="tags" column="tags"/>
        <result property="content" column="content"/>
        <result property="contact" column="contact"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.dbts.dreambacktosong_backend.domain.entity.Feedback" useGeneratedKeys="true"
            keyProperty="id">
        INSERT INTO feedback (user_id, rate, tags, content, contact, created_at)
        VALUES (#{userId}, #{rate}, #{tags}, #{content}, #{contact}, NOW())
    </insert>

    <select id="findByUserId" resultMap="FeedbackResultMap">
        SELECT id, user_id, rate, tags, content, contact, created_at
        FROM feedback
        WHERE user_id = #{userId}
        ORDER BY created_at DESC
    </select>

</mapper>
