<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dbts.dreambacktosong_backend.mapper.ProductImageMapper">

    <!-- 商品图片表映射，对应表：product_images -->
    <resultMap id="ProductImageResultMap" type="com.dbts.dreambacktosong_backend.domain.entity.ProductImage">
        <id property="id" column="id"/>
        <result property="productId" column="product_id"/>
        <result property="url" column="url"/>
        <result property="sortOrder" column="sort_order"/>
    </resultMap>

    <select id="findByProductId" resultMap="ProductImageResultMap">
        SELECT id, product_id, url, sort_order
        FROM product_images
        WHERE product_id = #{productId}
        ORDER BY sort_order ASC, id ASC
    </select>

</mapper>
