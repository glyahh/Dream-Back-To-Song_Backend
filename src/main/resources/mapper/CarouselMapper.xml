<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dbts.dreambacktosong_backend.mapper.CarouselMapper">

    <!-- 轮播图表映射，对应表：carousel -->
    <resultMap id="CarouselResultMap" type="com.dbts.dreambacktosong_backend.domain.entity.Carousel">
        <id property="id" column="id"/>
        <result property="image" column="image"/>
        <result property="title" column="title"/>
        <result property="link" column="link"/>
        <result property="sortOrder" column="sort_order"/>
    </resultMap>

    <select id="findAll" resultMap="CarouselResultMap">
        SELECT id, image, title, link, sort_order
        FROM carousel
        ORDER BY sort_order ASC, id DESC
    </select>

</mapper>
