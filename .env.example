# 梦回宋朝 · 后端环境变量配置模板
# 说明：
# 1. 复制此文件为 .env 并填写你的实际配置值
# 2. .env 文件已被 .gitignore 忽略，不会提交到代码仓库
# 3. application-dev.yml 和 application-build.yml 会优先读取 .env 中的值

############################
# 数据库配置
############################

DB_URL=jdbc:aws-wrapper:mysql://127.0.0.1:3306/dream_back_to_song?useSSL=false&serverTimezone=UTC&characterEncoding=utf-8
DB_USERNAME=root
DB_PASSWORD=your_password_here

############################
# Spring Profile
############################

SPRING_PROFILES_ACTIVE=dev

############################
# JWT 配置（登录鉴权）
############################

# 请修改为足够随机的长字符串，例如使用在线工具生成 32+ 位随机串
JWT_SECRET=your_jwt_secret_here

# token 过期时间（秒），与前端接口文档中的 expiresIn 对应
JWT_EXPIRES_IN=86400

############################
# 服务器配置
############################

SERVER_PORT=8080

############################
# 短信服务（占位，待你根据实际服务商填写）
############################

SMS_API_KEY=your_sms_api_key
SMS_API_SECRET=your_sms_api_secret
SMS_SIGN_NAME=梦回宋朝
SMS_TEMPLATE_CODE=login_code_template
